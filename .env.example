# Application
PORT=3000
NODE_ENV=development
TRUST_PROXY=0
LOG_LEVEL=debug

# Base de données
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_db

# MySQL (docker-compose)
DB_ROOT_PASSWORD=

# Authentification
# En production, utiliser un secret long et aléatoire (32+ caractères)
JWT_SECRET=change_me_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS (optionnel, liste séparée par des virgules)
# CORS_ORIGIN=http://localhost:5173,https://example.com

# Bootstrap admin optionnel (scripts/seed-admin.js)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!